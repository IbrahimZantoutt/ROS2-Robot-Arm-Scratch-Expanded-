<?xml version="1.0"?>
<robot name="arm_robot">

    <link name="robot_base">
        <visual>
            <geometry>
                <box size="0.3 0.15 0.1"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <box size="0.3 0.15 0.1"/>
            </geometry>
        </collision>
    </link>

    <link name="spin_link">
        <visual>
            <geometry>
                <sphere radius="0.035"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <sphere radius="0.035"/>
            </geometry>
        </collision>
    </link>

    <joint name="spin_main_joint" type="revolute">
        <parent link="robot_base"/>
        <child link="spin_link"/>
        <origin xyz="0 0 0.06" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14159" upper="3.14159" effort="10" velocity="1"/>
    </joint>

    <link name="spin_arm">
        <visual>
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.03" length="0.1"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.03" length="0.1"/>
            </geometry>
        </collision>
    </link>

    <joint name="spin_arm_joint" type="continuous">
        <parent link="spin_link"/>
        <child link="spin_arm"/>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="shoulder_link">
        <visual>
            <geometry>
                <sphere radius="0.035"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <sphere radius="0.035"/>
            </geometry>
        </collision>
    </link>

    <joint name="shoulder_main_joint" type="revolute">
        <parent link="spin_arm"/>
        <child link="shoulder_link"/>
        <origin xyz="0 0 0.1" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
    </joint>

    <link name="shoulder_arm">
        <visual>
            <origin xyz="0 0 0.15" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.03" length="0.4"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0.15" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.03" length="0.4"/>
            </geometry>
        </collision>
    </link>

    <joint name="shoulder_arm_joint" type="continuous">
        <parent link="shoulder_link"/>
        <child link="shoulder_arm"/>
        <origin xyz="0 0 0.04" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="elbow_link">
        <visual>
            <geometry>
                <sphere radius="0.035"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <sphere radius="0.035"/>
            </geometry>
        </collision>
    </link>

    <joint name="elbow_main_joint" type="revolute">
        <parent link="shoulder_arm"/>
        <child link="elbow_link"/>
        <origin xyz="0 0 0.35" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
    </joint>

    <link name="elbow_arm">
        <visual>
            <origin xyz="0 0 0.15" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.03" length="0.35"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0.15" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.03" length="0.35"/>
            </geometry>
        </collision>
    </link>

    <joint name="elbow_arm_joint" type="continuous">
        <parent link="elbow_link"/>
        <child link="elbow_arm"/>
        <origin xyz="0 0 0.035" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="wrist_link">
        <visual>
            <geometry>
                <sphere radius="0.035"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <sphere radius="0.035"/>
            </geometry>
        </collision>
    </link>

    <joint name="wrist_main_joint" type="revolute">
        <parent link="elbow_arm"/>
        <child link="wrist_link"/>
        <origin xyz="0 0 0.32" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
    </joint>

    <link name="wrist_arm">
        <visual>
            <origin xyz="0 0 0.025" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.012" length="0.05"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0.025" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.012" length="0.05"/>
            </geometry>
        </collision>
    </link>

    <joint name="wrist_arm_joint" type="continuous">
        <parent link="wrist_link"/>
        <child link="wrist_arm"/>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="gripper_base">
        <visual>
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
            <geometry>
                <box size="0.02 0.08 0.02"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
            <geometry>
                <box size="0.02 0.02 0.02"/>
            </geometry>
        </collision>
    </link>

    <joint name="gripper_base_joint" type="fixed">
        <parent link="wrist_arm"/>
        <child link="gripper_base"/>
        <origin xyz="0 0 0.01" rpy="0 0 0"/>
    </joint>


    <link name="gripper_left_finger">
        <visual>
            <origin xyz="0 0.025 0.035" rpy="0 0 0"/>
            <geometry>
                <box size="0.015 0.015 0.045"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0.025 0.02" rpy="0 0 0"/>
            <geometry>
                <box size="0.015 0.015 0.045"/>
            </geometry>
        </collision>
    </link>


    <joint name="gripper_left_finger_joint" type="prismatic">
        <parent link="gripper_base"/>
        <child link="gripper_left_finger"/>
        <origin xyz="0 0 0.045" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="0.0" upper="0.04" effort="5" velocity="0.1"/>
    </joint>

    <link name="gripper_right_finger">
        <visual>
            <origin xyz="0 -0.025 0.035" rpy="0 0 0"/>
            <geometry>
                <box size="0.015 0.015 0.045"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 -0.025 0.035" rpy="0 0 0"/>
            <geometry>
                <box size="0.015 0.015 0.045"/>
            </geometry>
        </collision>
    </link>


    <joint name="gripper_right_finger_joint" type="prismatic">
        <parent link="gripper_base"/>
        <child link="gripper_right_finger"/>
        <origin xyz="0 0 0.045" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="0.0" upper="0.04" effort="5" velocity="0.1"/>
    </joint>



</robot>
