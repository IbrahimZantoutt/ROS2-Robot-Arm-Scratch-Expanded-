<?xml version="1.0"?>
<robot name="arm_robot">

    <link name="robot_base">
        <visual>
            <geometry>
                <box size="0.3 0.15 0.1"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <box size="0.3 0.15 0.1"/>
            </geometry>
        </collision>
    </link>

    <link name="main_arm">
        <visual>
            <origin xyz="0 0 0.15" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.03" length="0.3"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0.15" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.03" length="0.3"/>
            </geometry>
        </collision>
    </link>

    <joint name="body_arm_joint" type="continuous">
        <parent link="robot_base"/>
        <child link="main_arm"/>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="shoulder_link">
        <visual>
            <geometry>
                <sphere radius="0.035"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <sphere radius="0.035"/>
            </geometry>
        </collision>
    </link>

    <joint name="shoulder_main_joint" type="revolute">
        <parent link="main_arm"/>
        <child link="shoulder_link"/>
        <origin xyz="0 0 0.3" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
    </joint>

    <link name="shoulder_arm">
        <visual>
            <origin xyz="0 0 0.15" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.03" length="0.3"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0.15" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.03" length="0.3"/>
            </geometry>
        </collision>
    </link>

    <joint name="shoulder_arm_joint" type="continuous">
        <parent link="shoulder_link"/>
        <child link="shoulder_arm"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="elbow_link">
        <visual>
            <geometry>
                <sphere radius="0.035"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <sphere radius="0.035"/>
            </geometry>
        </collision>
    </link>

    <joint name="elbow_shoulder_joint" type="revolute">
        <parent link="shoulder_arm"/>
        <child link="elbow_link"/>
        <origin xyz="0 0 0.3" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
    </joint>

    <link name="tip_arm">
        <visual>
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.025" length="0.2"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.025" length="0.2"/>
            </geometry>
        </collision>
    </link>

    <joint name="tip_arm_joint" type="continuous">
        <parent link="elbow_link"/>
        <child link="tip_arm"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

</robot>
